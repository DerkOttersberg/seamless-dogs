{
  "schemaVersion": 1,
  "id": "seamlessdogs",
  "version": "${version}",
  "name": "Seamless Dogs",
  "description": "Pet your own dogs and cats with a keybind, animated hands, expressive eyes and entity-bound sounds. Calm pets can dig or stretch, with owner and server settings.",
  "authors": [
    "Derk Ottersberg"
  ],
  "license": "All rights reserved",
  "environment": "*",
  "icon": "assets/seamlessdogs/icon.png",
  "entrypoints": {
    "main": [
      "io.github.derkottersberg.seamlessdogs.fabric.DogsFabric"
    ],
    "client": [
      "io.github.derkottersberg.seamlessdogs.fabric.DogsFabricClient"
    ],
    "modmenu": [
      "io.github.derkottersberg.seamlessdogs.fabric.DogsModMenu"
    ]
  },
  "mixins": [
    "seamlessdogs.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": ">=0.161.0 <0.162.0",
    "minecraft": "26.3",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": ">=21.0.0 <22.0.0"
  }
